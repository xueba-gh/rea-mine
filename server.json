{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.xueba-gh/build-anything",
  "title": "Build Anything",
  "description": "Reverse engineer and understand anything from your terminal or agent with one CLI and MCP server.",
  "websiteUrl": "https://github.com/xueba-gh/build-anything",
  "repository": {
    "url": "https://github.com/xueba-gh/build-anything",
    "source": "github"
  },
  "version": "6.7.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "build-anything",
      "version": "6.7.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
